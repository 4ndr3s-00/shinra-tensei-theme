{
  "$schema": "vscode://schemas/color-theme",
  "name": "Shinra Tensei (Rinnegan)",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#E4DEEE",
    "variable.readonly": "#B8E09B",
    "property": "#C3A6E1",
    "property.readonly": "#B8E09B",
    "parameter": "#D9CEE8",
    "function": {
      "foreground": "#BFA5D9",
      "bold": true
    },
    "method": {
      "foreground": "#BFA5D9",
      "bold": true
    },
    "class": "#89DCEB",
    "type": "#89DCEB",
    "interface": "#81D4C8",
    "namespace": "#89DCEB",
    "enum": "#89DCEB",
    "enumMember": "#B8E09B",
    "decorator": "#C3A6E1"
  },
  "colors": {
    "focusBorder": "#BFA5D966",
    "foreground": "#E4DEEE",
    "descriptionForeground": "#988DA8",
    "errorForeground": "#ED7882",
    "widget.shadow": "#00000080",
    "selection.background": "#BFA5D933",
    "icon.foreground": "#BAACCB",

    "window.activeBorder": "#BFA5D933",
    "window.inactiveBorder": "#181520",

    "titleBar.activeBackground": "#100E14",
    "titleBar.activeForeground": "#E4DEEE",
    "titleBar.inactiveBackground": "#0D0B10",
    "titleBar.inactiveForeground": "#766C85",
    "titleBar.border": "#201B28",

    "activityBar.background": "#100E14",
    "activityBar.foreground": "#BFA5D9",
    "activityBar.inactiveForeground": "#5B526A",
    "activityBar.border": "#201B28",
    "activityBarBadge.background": "#BFA5D9",
    "activityBarBadge.foreground": "#100E14",

    "sideBar.background": "#15121B",
    "sideBar.foreground": "#C8BED6",
    "sideBar.border": "#201B28",
    "sideBarTitle.foreground": "#E4DEEE",
    "sideBarSectionHeader.background": "#191522",
    "sideBarSectionHeader.foreground": "#D9CEE8",
    "sideBarSectionHeader.border": "#201B28",

    "editorGroupHeader.tabsBackground": "#100E14",
    "editorGroupHeader.tabsBorder": "#201B28",
    "tab.activeBackground": "#1A1623",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorderTop": "#BFA5D9",
    "tab.inactiveBackground": "#110F16",
    "tab.inactiveForeground": "#7A708A",
    "tab.border": "#191521",
    "tab.hoverBackground": "#16131E",
    "tab.hoverForeground": "#D9CEE8",

    "editor.background": "#131118",
    "editor.foreground": "#E4DEEE",
    "editorLineNumber.foreground": "#4F475B",
    "editorLineNumber.activeForeground": "#BFA5D9",
    "editorCursor.foreground": "#BFA5D9",
    "editor.selectionBackground": "#BFA5D930",
    "editor.selectionHighlightBackground": "#BFA5D91C",
    "editor.inactiveSelectionBackground": "#BFA5D918",
    "editor.wordHighlightBackground": "#BFA5D922",
    "editor.wordHighlightStrongBackground": "#BFA5D933",
    "editor.findMatchBackground": "#E5C07B44",
    "editor.findMatchHighlightBackground": "#BFA5D928",
    "editor.lineHighlightBackground": "#1D192744",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#201A29",
    "editorIndentGuide.activeBackground1": "#BFA5D94D",
    "editorRuler.foreground": "#201A29",
    "editorBracketMatch.background": "#BFA5D925",
    "editorBracketMatch.border": "#BFA5D966",

    "editorOverviewRuler.border": "#100E14",
    "editorOverviewRuler.findMatchForeground": "#E5C07B88",
    "editorOverviewRuler.selectionHighlightForeground": "#BFA5D966",

    "statusBar.background": "#100E14",
    "statusBar.foreground": "#BFA5D9",
    "statusBar.border": "#201B28",
    "statusBar.debuggingBackground": "#ED7882",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#100E14",
    "statusBarItem.hoverBackground": "#BFA5D91C",
    "statusBarItem.activeBackground": "#BFA5D933",

    "panel.background": "#131118",
    "panel.border": "#201B28",
    "panelTitle.activeForeground": "#BFA5D9",
    "panelTitle.inactiveForeground": "#695F77",
    "panelTitle.activeBorder": "#BFA5D9",

    "terminal.background": "#131118",
    "terminal.foreground": "#E4DEEE",
    "terminal.ansiBlack": "#1A1623",
    "terminal.ansiRed": "#ED7882",
    "terminal.ansiGreen": "#A6D189",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#89DCEB",
    "terminal.ansiMagenta": "#BFA5D9",
    "terminal.ansiCyan": "#81D4C8",
    "terminal.ansiWhite": "#E4DEEE",
    "terminal.ansiBrightBlack": "#554C64",
    "terminal.ansiBrightRed": "#F08993",
    "terminal.ansiBrightGreen": "#B8E09B",
    "terminal.ansiBrightYellow": "#ECD196",
    "terminal.ansiBrightBlue": "#A5E6F2",
    "terminal.ansiBrightMagenta": "#D1BCF0",
    "terminal.ansiBrightCyan": "#9DE0D7",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "button.background": "#BFA5D9",
    "button.foreground": "#100E14",
    "button.hoverBackground": "#CEB8E4",
    "button.secondaryBackground": "#272133",
    "button.secondaryForeground": "#E4DEEE",
    "button.secondaryHoverBackground": "#332B42",

    "input.background": "#191522",
    "input.foreground": "#E4DEEE",
    "input.border": "#2B2337",
    "input.placeholderForeground": "#695F77",
    "inputOption.activeBorder": "#BFA5D9",

    "dropdown.background": "#191522",
    "dropdown.foreground": "#E4DEEE",
    "dropdown.border": "#2B2337",

    "list.activeSelectionBackground": "#251F31",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#1C1725",
    "list.inactiveSelectionForeground": "#E4DEEE",
    "list.hoverBackground": "#191522",
    "list.hoverForeground": "#FFFFFF",
    "list.focusBackground": "#251F31",
    "list.highlightForeground": "#BFA5D9",

    "badge.background": "#BFA5D9",
    "badge.foreground": "#100E14",
    "progressBar.background": "#BFA5D9",

    "gitDecoration.addedResourceForeground": "#A6D189",
    "gitDecoration.modifiedResourceForeground": "#E5C07B",
    "gitDecoration.deletedResourceForeground": "#ED7882",
    "gitDecoration.untrackedResourceForeground": "#89DCEB",
    "gitDecoration.ignoredResourceForeground": "#554C64",

    "breadcrumb.foreground": "#7A708A",
    "breadcrumb.background": "#131118",
    "breadcrumb.activeSelectionForeground": "#BFA5D9",
    "breadcrumb.focusForeground": "#E4DEEE",

    "notifications.background": "#1A1623",
    "notifications.foreground": "#E4DEEE",
    "notifications.border": "#BFA5D933",
    "notificationLink.foreground": "#BFA5D9"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6F6880",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Soft Rinnegan Lilac: Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "support.function.builtin",
        "entity.name.method",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#BFA5D9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Soft Akatsuki Coral: Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ED7882"
      }
    },
    {
      "name": "Calm Mist Cyan: Classes, Types & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.type.interface",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#89DCEB"
      }
    },
    {
      "name": "Soft Sunset Amber: Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "name": "Sage Chakra Green: Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language"
      ],
      "settings": {
        "foreground": "#A6D189"
      }
    },
    {
      "name": "Mist White / Soft Lilac: Variables & Parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#E4DEEE"
      }
    },
    {
      "name": "Soft Mauve: Object Properties & Decorators",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.property-name",
        "entity.other.attribute-name",
        "meta.decorator",
        "tag.decorator.entity.name"
      ],
      "settings": {
        "foreground": "#C3A6E1"
      }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ED7882"
      }
    },
    {
      "name": "Attributes (HTML/CSS)",
      "scope": [
        "entity.other.attribute-name",
        "support.type.vendor-prefix"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#B3A7C2"
      }
    },
    {
      "name": "Brackets & Curly Braces",
      "scope": [
        "punctuation.section",
        "punctuation.definition.parameters"
      ],
      "settings": {
        "foreground": "#D9CEE8"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "heading.1.markdown",
        "heading.2.markdown",
        "heading.3.markdown",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#BFA5D9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#89DCEB"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ED7882",
        "fontStyle": "bold"
      }
    }
  ]
}
