    "terminal.ansiBrightBlue": "#89DCEB",
    "terminal.ansiBrightMagenta": "#CEB8E4",
    "terminal.ansiBrightCyan": "#81D4C8",
    "terminal.ansiBrightWhite": "#FFFFFF",
