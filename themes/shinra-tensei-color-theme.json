    "panelTitle.inactiveForeground": "#695F77",
    "panelTitle.activeBorder": "#BFA5D9",
    "terminal.background": "#131118",
    "terminal.foreground": "#E4DEEE",
    "terminal.ansiBlack": "#191522",
    "terminal.ansiRed": "#ED7882",
