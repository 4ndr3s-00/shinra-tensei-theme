  "tokenColors": [
    {
      "name": "Comments & Documentation",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#787186",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage Modifiers",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.delete",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E06D77"
      }
    },
    {
      "name": "Language Constants (this, super, self, arguments)",
      "scope": [
        "variable.language.this",
        "variable.language.super",
        "variable.language.arguments",
        "variable.language.special.self.python",
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#E06D77",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Method Declarations",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "meta.function-call",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#B59CCE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "React Hooks & Framework Functions",
      "scope": [
        "support.function.react",
        "entity.name.function.react",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#B59CCE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes, Interfaces, Types & Generics",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.type.interface",
        "entity.name.type.module",
        "entity.name.type.alias",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#7ECCD8"
      }
    },
    {
      "name": "Strings & Character Literals",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#DCB772"
      }
    },
    {
      "name": "String Interpolation & Template Punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#E06D77"
      }
    },
    {
      "name": "Numbers, Units & Booleans",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#9EC981"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#DDD7E7"
      }
    },
    {
      "name": "Object Keys & Properties",
      "scope": [
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#B99CD7"
      }
    },
    {
      "name": "HTML & JSX Native Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.structure.any.html",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E06D77"
      }
    },
    {
      "name": "React / Vue / Svelte Custom Component Tags",
      "scope": [
        "support.class.component",
        "entity.name.tag.custom",
        "entity.name.tag.tsx",
        "entity.name.tag.jsx",
        "meta.tag.custom"
      ],
      "settings": {
        "foreground": "#7ECCD8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#B99CD7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Property Names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#7ECCD8"
      }
    },
    {
      "name": "CSS Property Values & Constants",
