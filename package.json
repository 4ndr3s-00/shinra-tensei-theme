{
  "name": "shinra-tensei-theme",
  "displayName": "Shinra Tensei",
  "icon": "assets/icon.png",
  "description": "An elegant, dark obsidian and Rinnegan purple VS Code theme inspired by Pain (Naruto Shippuden).",
  "version": "1.4.0",
  "publisher": "4ndr3s-00",
  "author": {
    "name": "Andrés"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/4ndr3s-00/shinra-tensei-theme.git"
  },
  "bugs": {
    "url": "https://github.com/4ndr3s-00/shinra-tensei-theme/issues"
  },
  "keywords": [
    "theme",
    "dark",
    "purple",
    "obsidian",
    "pain",
    "rinnegan",
    "naruto",
    "akatsuki",
    "anime",
    "dracula",
    "catppuccin",
    "kitty",
    "fish",
    "bracket-pair-colorizer",
    "inlay-hints",
    "aesthetic",
    "rice",
    "hyprland"
  ],
  "categories": [
    "Themes"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "build:icons": "node ./scripts/build-icons.js",
    "test": "node ./scripts/lint.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run build && npm test"
  },
  "contributes": {
    "themes": [
      {
        "label": "Shinra Tensei (Rinnegan)",
        "uiTheme": "vs-dark",
        "path": "./themes/shinra-tensei-color-theme.json"
      },
      {
        "label": "Shinra Tensei Soft (Amegakure Rain)",
        "uiTheme": "vs-dark",
        "path": "./themes/shinra-tensei-soft-color-theme.json"
      },
      {
        "label": "Shinra Tensei Intense (Chibaku Tensei)",
        "uiTheme": "vs-dark",
        "path": "./themes/shinra-tensei-intense-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "shinra-tensei-icons",
        "label": "Shinra Tensei Icons",
        "path": "./icons/shinra-tensei-icons.json"
      }
    ]
  },
  "devDependencies": {
    "js-yaml": "^5.5.0"
  }
}
